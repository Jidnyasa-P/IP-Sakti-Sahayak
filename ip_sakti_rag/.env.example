# =============================================================================
# ip_sakti_rag/.env — copy to ip_sakti_rag/.env for local dev.
# On Render, set these in the service's Environment tab instead of a file.
# =============================================================================

# --- Gemini (embeddings via gemini-embedding-001 + answer generation +
#     Gemini-mode reranking, all via the one google-genai SDK/key) ---
# Free key from https://aistudio.google.com/apikey
# NOTE (2026-09): gemini-2.5-flash still works today but Google has it
# scheduled for shutdown on 2026-10-16 — don't build on it now. gemini-2.0-
# flash is already shut down (since 2026-06-01), which is what broke the
# original setup. gemini-3.1-flash-lite is the current stable, cheap,
# free-tier-eligible pick with no announced shutdown date; swap to
# gemini-3-flash-preview if you need more reasoning power and don't mind
# it being a preview model. Re-check https://ai.google.dev/gemini-api/docs/models
# before your demo either way — this list moves fast.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# --- Qdrant Cloud (from your Qdrant Cloud cluster's "Connect" panel) ---
QDRANT_URL=https://YOUR-CLUSTER-ID.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ip_sakti_chunks

# --- Neo4j Aura (from the Aura console "Connection details") ---
# All three of URI/USERNAME/PASSWORD must be set (and NEO4J_ENABLED=true)
# for graph.py to connect; if any is missing, graph enrichment is silently
# skipped (rest of the pipeline still works). Free tier auto-pauses after
# ~72h idle — first query after a pause will be slow while it wakes back up.
NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://YOUR-INSTANCE-ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- TKDL (kept off — no authorized access. Do not enable without a real
#     authorized-access mechanism in place; see app/retrieval/tkdl_connector.py) ---
TKDL_ENABLED=false

# --- Bhashini (used ONLY for translating final answers / UI strings —
#     NOT used for retrieval, since embeddings are multilingual) ---
TRANSLATION_PROVIDER=none   # none | bhashini
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=

# --- Shared secret so only your trusted caller (frontend/backend) can call
#     this microservice once it's public on Render ---
RAG_SERVICE_SHARED_SECRET=change-me-in-production

# --- Retrieval tuning ---
TOP_K=5

# --- Re-ranking: second pass on top of RRF fusion (see
#     app/retrieval/reranker.py). Both modes are free-tier-safe — neither
#     loads a local model. ---
# RERANKER_ENABLED=false to disable re-ranking entirely (RRF order used as-is).
RERANKER_ENABLED=true
# gemini: one batched Gemini call per query, scores the top RERANK_CANDIDATES
#         fused chunks at once; auto-falls-back to lexical on any failure.
# lexical: zero network calls, a query-term-coverage + proximity heuristic.
RERANKER_MODE=gemini
RERANK_CANDIDATES=12

# --- Safety thresholds ---
CONFIDENCE_HIGH_THRESHOLD=0.45
CONFIDENCE_MODERATE_THRESHOLD=0.28
CONFIDENCE_LOW_THRESHOLD=0.15
MIN_CHUNKS_FOR_HIGH_CONFIDENCE=3
ABSTAIN_BELOW_SCORE=0.15
