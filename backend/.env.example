# =============================================================================
# IP-SAKTI Sahayak -- Backend Environment Configuration
# Copy this file to .env and fill in values. Every variable has a safe,
# clearly-labelled fallback ("DEMO MODE") if left blank.
#
# RAG (retrieval + LLM reasoning + knowledge graph + vector store) now lives
# entirely in the sibling `ip_sakti_rag` service -- configure that service's
# own .env (ip_sakti_rag/.env) separately. This backend only needs to know
# how to REACH it, via RAG_SERVICE_URL below.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Persistent application database ---
# MongoDB is the sole application datastore (conversations, chat messages,
# product analyses, saved research, expert escalations, audit records,
# feedback).
#
# Leave MONGODB_URI blank to run against an in-process, pymongo-API
# compatible in-memory store (DEMO MODE -- resets on every restart, zero
# setup needed). Set it to a real MongoDB to get a persistent database.
MONGODB_URI=
MONGODB_DB_NAME=ip_sakti

# --- RAG microservice (ip_sakti_rag) ---
# Point this at wherever ip_sakti_rag is running. Local dev default: 8001.
# On Render, set this to the deployed ip_sakti_rag service's URL.
RAG_SERVICE_URL=http://localhost:8001
# Must match ip_sakti_rag's RAG_SERVICE_SHARED_SECRET exactly (if that
# service has one configured). Leave both blank for local dev.
RAG_SERVICE_SHARED_SECRET=
RAG_SERVICE_TIMEOUT_SECONDS=30

# --- Multilingual / translation provider (UI strings; unrelated to RAG) ---
# Leave blank to use the local curated Hindi/Marathi statutory dictionaries.
TRANSLATION_PROVIDER=bhashini
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=

# --- Security ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# =============================================================================
# --- Email (Resend HTTPS API) ---
# =============================================================================
EMAIL_BACKEND=brevo
BREVO_API_KEY=<your Brevo API key>
EMAIL_FROM_ADDRESS=<your verified Brevo sender email>
EMAIL_FROM_NAME=IP-SAKTI Sahayak
CONTACT_RECIPIENT=<your email>

# --- Email verification (OTP) ---
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_PEPPER=
REQUIRE_EMAIL_VERIFICATION=true

# --- Device / sign-in security alerts ---
SECURITY_HASH_KEY=
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
CONCURRENT_SESSION_WINDOW_MINUTES=60
SECURITY_ALERT_COOLDOWN_MINUTES=1440

# --- Uploads (chatbot attachments + certificates) ---
UPLOAD_DIR=storage            # relative to backend/; must NOT be served statically; back it up / encrypt the volume
MAX_DOCUMENT_MB=10
MAX_IMAGE_MB=8
MAX_CERTIFICATE_MB=5
MAX_ATTACHMENTS_PER_CONVERSATION=20
MAX_UPLOADS_PER_HOUR=30
ATTACHMENT_TEXT_MAX_CHARS=200000
ATTACHMENT_CONTEXT_MAX_CHARS=6000
OCR_ENABLED=true              # effective only if pytesseract + Pillow + the tesseract binary are installed
URL_FETCH_TIMEOUT_SECONDS=10
URL_MAX_BYTES=2000000
URL_MAX_REDIRECTS=3
URL_ALLOWED_PORTS=80,443

# --- Expert certificates ---
CERT_VERIFICATION_PROVIDER=none   # "none" until a real registry adapter is registered (see docs/NEW_FEATURES.md)
REQUIRE_VERIFIED_EXPERT_CERTIFICATE=false

# --- Hardening ---
# Original behaviour lets anyone self-register as Admin. Set to false in production.
PUBLIC_ADMIN_SIGNUP_ENABLED=true